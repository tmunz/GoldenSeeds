.graph-node {
  min-width: 160px;
  border: 1px solid var(--textColorAlt);
  border-radius: 4px;
  background: unquote('rgb(var(--backgroundColorAlt))');
  color: var(--textColor);
  font-size: 11px;

  .graph-node-header {
    padding: 4px 8px;
    border-bottom: 1px solid var(--textColorAlt);
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: grab;
  }

  .graph-node-body {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    gap: 12px;
  }

  .graph-node-ports {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .graph-node-inputs {
    align-items: flex-start;
  }

  .graph-node-outputs {
    align-items: flex-end;
  }

  .graph-node-port {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 8px;
    white-space: nowrap;
  }

  .graph-node-port-editable {
    align-self: stretch;
    min-width: 180px;

    >.number-parameter-editor, >.expression-parameter-editor, >.string-parameter-editor {
      width: 100%;
    }
  }

  .graph-node-option-editor {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    padding: 6px 0;
    color: var(--textColor);

    select {
      font: inherit;
      padding: 4px;
      color: var(--actionColor);
      background: unquote('rgb(var(--backgroundColorAlt))');
      border: 1px solid var(--textColorAlt);
      border-radius: 3px;
    }
  }

  .graph-node-port-label {
    color: var(--textColorAlt);
  }

  .graph-node-port-value {
    color: var(--textColor);
    font-style: italic;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80px;
  }

  .graph-node-port-value-default {
    color: var(--textColorAlt);
    opacity: 0.7;
  }
}
