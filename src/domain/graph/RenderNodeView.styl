.render-node {
  position: relative;
  border: 1px solid var(--textColorAlt);
  border-radius: 4px;
  background: unquote('rgb(var(--backgroundColorAlt))');
  color: var(--textColor);
  font-size: 11px;

  .render-node-header {
    padding: 4px 8px;
    border-bottom: 1px solid var(--textColorAlt);
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: grab;
  }

  .render-node-body {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
  }

  .render-node-ports {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .render-node-port {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 8px;
    white-space: nowrap;
  }

  .render-node-port-label {
    color: var(--textColorAlt);
  }

  .render-node-preview {
    width: 240px;
    height: 240px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;

    .svg-canvas {
      max-width: 100%;
      max-height: 100%;
    }
  }
}
