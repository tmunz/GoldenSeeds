.render-node {
  width: 0px;
  height: 66px;
  box-sizing: border-box;
  transform-origin: top left;
  background: unquote('rgb(var(--backgroundColorAlt))');
  color: var(--textColor);
  font-size: 11px;

  .render-node-header {
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .render-node-port {
    position: relative;
    display: flex;
    align-items: center;
    height: 22px;
    white-space: nowrap;
    color: var(--textColorAlt);
  }
}
